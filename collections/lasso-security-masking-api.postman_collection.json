  "info": {
    "_postman_id": "07e91bbb-ae4b-4ea5-a74e-7cc2aa98f6e2",
    "name": "Lasso Security / Threat Detection Classify Masking API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "REST API for Lasso Security's GenAI guardrails. The Classify endpoint scores LLM prompts and completions for security violations - prompt injection, jailbreaks, harmful content, custom policies, and PII - and returns structured findings (\"deputies\") with action levels (BLOCK, WARN, AUTO_MASKING) and severity. The Classifix endpoint additionally returns PII-masked messages. Endpoints and field names are derived from public integrations (LiteLLM, Portkey) and the open-source Lasso MCP Gateway; consult Lasso for the authoritative reference.\n\nContact Support:\n Name: Lasso Security",
      "type": "text/plain"
    }
  }
